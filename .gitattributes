* text=auto

*.html text eol=lf
*.svg text eol=lf
# Unified diffs prefix context (including tabs/empty lines) with one space.
# Their replay verifiers still compare the resulting source bytes exactly.
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
*.sh text eol=lf
# Compared byte-for-byte with the platform-independent manual generator.
crates/mant/src/arguments/help_tldr_generated.rs text eol=lf
# Roff matrix sources and sealed rows are bound to exact pristine profile bytes.
# Windows autocrlf must not alter the input covered by the recorded source hash.
crates/mant-engine/tests/**/*.1 text eol=lf
crates/mant-engine/tests/roff_lowering/grouped_line_flush/literal-tab.1 whitespace=-blank-at-eol
crates/libmandoc-rs/tests/fixtures/table-execution/*.1 text eol=lf
crates/libmandoc-rs/tests/fixtures/markdown-renderer/*.mdoc text eol=lf
crates/libmandoc-rs/tests/fixtures/markdown-renderer/*.man text eol=lf
crates/libmandoc-rs/tests/fixtures/markdown-renderer/*.expected text eol=lf whitespace=-blank-at-eol
crates/mant-engine/tests/roff_lowering/**/*.expected text eol=lf
crates/mant-engine/tests/roff_lowering/annotation_publication/*.jsonl text eol=lf
tests/fixtures/roff/literal_leading_rows/**/*.1 text eol=lf
tests/fixtures/roff/table_layout/*.1 text eol=lf
crates/libmandoc-rs/patches/series text eol=lf
crates/libmandoc-rs/scripts/* text eol=lf
# Preserve upstream whitespace byte-for-byte; SOURCE/FILES and patch replay
# validate this generated tree, which is not formatted as authored project code.
crates/libmandoc-rs/vendor/** text eol=lf -whitespace
crates/libmandoc-rs/upstream/** text eol=lf
# Distributed native license copies must remain byte-identical to upstream.
crates/libmandoc-rs/LICENSES/** text eol=lf
*.gz binary
*.zst binary
*.zip binary
*.png binary
*.woff2 binary
tests/fixtures/roff/real/source-adjacency/*.1 text eol=lf
tests/fixtures/roff/real/scoped-layout/* text eol=lf
tests/fixtures/roff/real/field-boundaries/*.1 text eol=lf -whitespace
tests/fixtures/roff/real/mathematical-export/*.0p text eol=lf -whitespace
tests/fixtures/roff/real/mathematical-export/*.3p text eol=lf -whitespace
tests/fixtures/roff/real/mathematical-export/*.3 text eol=lf -whitespace
tests/fixtures/roff/real/mathematical-export/*.1 text eol=lf -whitespace
# These complete authored notices include their upstream final blank line.
tests/fixtures/roff/real/LICENSES/** text eol=lf
tests/fixtures/roff/real/LICENSES/BPF-MANUAL-LICENSE.txt text eol=lf whitespace=-blank-at-eof
tests/fixtures/roff/real/LICENSES/BHYVE-MANUAL-BSD-2-Clause.txt text eol=lf whitespace=-blank-at-eof
tests/fixtures/roff/real/LICENSES/KSH-MANUAL-PUBLIC-DOMAIN.txt text eol=lf whitespace=-blank-at-eof
tests/fixtures/roff/real/LICENSES/CDDL-1.0.txt text eol=lf whitespace=-blank-at-eof
