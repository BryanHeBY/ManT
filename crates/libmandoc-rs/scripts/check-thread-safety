#!/usr/bin/env bash
# Run libmandoc-rs concurrency stress tests with Rust and vendored C instrumented.

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
cd "$ROOT"

rounds=64
if (( $# > 0 )); then
  if [[ ${1:-} != --rounds || $# != 2 || ! ${2:-} =~ ^[1-9][0-9]*$ ]]; then
    echo "usage: check-thread-safety [--rounds positive-integer]" >&2
    exit 2
  fi
  rounds=$2
fi
if (( rounds > 10000 )); then
  echo "check-thread-safety: --rounds must not exceed 10000" >&2
  exit 2
fi

if ! command -v rustup >/dev/null || ! command -v nm >/dev/null; then
  echo "check-thread-safety: rustup and nm are required" >&2
  exit 1
fi
if ! rustup toolchain list | grep -Eq '^nightly(-|[[:space:]])'; then
  echo "check-thread-safety: install a nightly toolchain with 'rustup toolchain install nightly'" >&2
  exit 1
fi
if ! rustup component list --toolchain nightly | grep -Eq '^rust-src .*\(installed\)$'; then
  echo "check-thread-safety: install rust-src with 'rustup component add rust-src --toolchain nightly'" >&2
  exit 1
fi

target=$(rustc +nightly -vV | sed -n 's/^host: //p')
case "$target" in
  x86_64-unknown-linux-gnu | aarch64-unknown-linux-gnu | \
    x86_64-apple-darwin | aarch64-apple-darwin) ;;
  *)
    echo "check-thread-safety: unsupported ThreadSanitizer host '$target'" >&2
    exit 1
    ;;
esac

if [[ -n ${CARGO_TARGET_DIR:-} ]]; then
  sanitizer_target_dir="$CARGO_TARGET_DIR/libmandoc-rs-tsan"
else
  sanitizer_target_dir="$ROOT/target/libmandoc-rs-tsan"
fi
sanitizer_options="${TSAN_OPTIONS:+$TSAN_OPTIONS:}halt_on_error=1:exitcode=66"

printf 'ThreadSanitizer target: %s\n' "$target"
printf 'Stress rounds per worker: %s\n' "$rounds"
env \
  CARGO_TARGET_DIR="$sanitizer_target_dir" \
  LIBMANDOC_RS_TSAN=1 \
  LIBMANDOC_RS_TSAN_ROUNDS="$rounds" \
  RUSTFLAGS=-Zsanitizer=thread \
  RUSTDOCFLAGS=-Zsanitizer=thread \
  TSAN_OPTIONS="$sanitizer_options" \
  cargo +nightly test --locked -Zbuild-std --target "$target" \
    --package libmandoc-rs --features render --test thread_safety -- \
    --ignored --nocapture --test-threads=1

archive=$(find "$sanitizer_target_dir/$target/debug/build" \
  -name libmant_mandoc.a -print -quit)
if [[ -z "$archive" ]]; then
  echo "check-thread-safety: could not locate the vendored C archive" >&2
  exit 1
fi
instrumented_symbols=$(nm -u "$archive" | grep -E '__tsan_(func_entry|read|write)' || true)
if [[ -z "$instrumented_symbols" ]]; then
  echo "check-thread-safety: vendored C objects were not instrumented" >&2
  exit 1
fi

printf 'ThreadSanitizer passed; Rust std, Rust crate code, and vendored C were instrumented.\n'
