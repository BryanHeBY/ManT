+/*
+ * Parse one caller-owned memory buffer without opening files.
+ * The embedding application owns source I/O, decompression, and .so policy.
+ */
+void
+mparse_readmem(struct mparse *curp, const unsigned char *data, size_t size,
+    const char *filename)
+{
+	struct buf	 blk;
+	struct buf	*save_primary;
+	const char	*save_filename, *cp;
+	size_t		 offset;
+	int		 save_filenc, save_lineno;
+
+	if ((cp = strrchr(filename, '.')) != NULL &&
+	    cp[1] >= '1' && cp[1] <= '9')
+		curp->man->filesec = cp[1];
+	else
+		curp->man->filesec = '\0';
+
+	blk.buf = (char *)data;
+	blk.sz = size;
+	blk.next = NULL;
+	save_primary = curp->primary;
+	save_filenc = curp->filenc;
+	save_lineno = curp->line;
+	save_filename = mandoc_msg_getinfilename();
+
+	curp->primary = &blk;
+	curp->filenc = curp->options & (MPARSE_UTF8 | MPARSE_LATIN1);
+	curp->line = 1;
+	mandoc_msg_setinfilename(filename);
+	if (curp->filenc & MPARSE_UTF8 && blk.sz > 2 &&
+	    data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf) {
+		offset = 3;
+		curp->filenc &= ~MPARSE_LATIN1;
+	} else
+		offset = 0;
+
+	mparse_buf_r(curp, blk, offset, 1);
+	mparse_end(curp);
+
+	curp->primary = save_primary;
+	curp->filenc = save_filenc;
+	curp->line = save_lineno;
+	mandoc_msg_setinfilename(save_filename);
+}
