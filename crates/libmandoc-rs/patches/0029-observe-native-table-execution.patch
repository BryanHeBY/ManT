+static int
+tbl_exec_preflight(struct termp *tp, const struct tbl_span *first,
+    size_t *rows, size_t *layout_cells, size_t *data_cells)
+{
+	const struct tbl_span *sp;
+	const struct tbl_cell *cp;
+	const struct tbl_dat *dp;
+	size_t columns, length;
+
+	*rows = *layout_cells = *data_cells = 0;
+	if (first == NULL || first->opts == NULL || first->opts->cols <= 0)
+		return 0;
+	columns = (size_t)first->opts->cols;
+	if (columns > SIZE_MAX / columns ||
+	    !term_exec_table_preflight(tp, columns * columns))
+		return 0;
+	for (sp = first; sp != NULL; sp = sp->next) {
+		if (*rows == SIZE_MAX || !term_exec_table_preflight(tp, 1))
+			return 0;
+		(*rows)++;
+		for (cp = sp->layout->first; cp != NULL; cp = cp->next) {
+			if (*layout_cells == SIZE_MAX ||
+			    !term_exec_table_preflight(tp, 1))
+				return 0;
+			(*layout_cells)++;
+		}
+		for (dp = sp->first; dp != NULL; dp = dp->next) {
+			if (*data_cells == SIZE_MAX ||
+			    !term_exec_table_preflight(tp, columns + 1))
+				return 0;
+			(*data_cells)++;
+			if (dp->string != NULL) {
+				length = strlen(dp->string);
+				if (length == SIZE_MAX ||
+				    !term_exec_table_preflight(tp, length + 1))
+					return 0;
+			}
+		}
+	}
+	return 1;
+}
