Subject: expose retained manual tag origin
Upstream-Status: Local embedding (not submitted)

Let the structured collector distinguish source-authored `.Tg` destinations
from formatter-generated targets while the parser-owned tag table is alive.
The query is read-only and does not change normal rendering behavior.

--- a/tag.c
+++ b/tag.c
@@ -240,6 +240,23 @@ tag_exists(const char *tag)
 	return ohash_find(&tag_data, ohash_qlookup(&tag_data, tag)) != NULL;
 }
 
+/*
+ * Report whether the retained owner for this exact target came from .Tg.
+ * The embedding collector calls this while the parser and tag table are
+ * still alive; generated targets with the same spelling have already lost
+ * NODE_ID when TAG_MANUAL won priority in tag_put().
+ */
+int
+mant_tag_is_manual(const char *tag)
+{
+	struct tag_entry *entry;
+
+	if (tag == NULL)
+		return 0;
+	entry = ohash_find(&tag_data, ohash_qlookup(&tag_data, tag));
+	return entry != NULL && entry->prio == TAG_MANUAL;
+}
+
 /*
  * For in-line elements, move the link target
  * to the enclosing paragraph when appropriate.
--- a/tag.h
+++ b/tag.h
@@ -30,6 +30,7 @@
 
 void		 tag_alloc(void);
 int		 tag_exists(const char *);
+int		 mant_tag_is_manual(const char *);
 void		 tag_put(const char *, int, struct roff_node *);
 void		 tag_postprocess(struct roff_man *, struct roff_node *);
 void		 tag_free(void);
