+	/* Cleanup must not require stack proportional to a rejected tree. */
+	root = n;
+	for (;;) {
+		if (n->child != NULL) {
+			n = n->child;
+			continue;
+		}
+		parent = n->parent;
+		roff_node_unlink(man, n);
+		if (n == root) {
+			roff_node_free(n);
