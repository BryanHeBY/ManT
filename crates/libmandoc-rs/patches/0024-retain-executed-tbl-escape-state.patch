Subject: retain executed tbl escape state
Upstream-Status: Local embedding (not submitted)

Expose the parser's actual escape state at each tbl row.  Source-backed
recovery needs this lexical fact to remove comments safely without simulating
conditionals or macro execution from raw source.

--- a/roff.c
+++ b/roff.c
@@ -174,7 +174,7 @@
 static	int		 roffnode_pop(struct roff *);
 static	void		 roffnode_push(struct roff *, enum roff_tok,
 				const char *, int, int);
-static	void		 roff_addtbl(struct roff_man *, int, struct tbl_node *);
+static	void		 roff_addtbl(struct roff *, int, struct tbl_node *);
 static	int		 roff_als(ROFF_ARGS);
@@ -1101,12 +1101,14 @@
 }
 
 static void
-roff_addtbl(struct roff_man *man, int line, struct tbl_node *tbl)
+roff_addtbl(struct roff *r, int line, struct tbl_node *tbl)
 {
 	struct roff_node	*n;
 	struct tbl_span	*span;
 	struct roff_man	*man;
 
+	man = r->man;
 	if (man->meta.macroset == MACROSET_MAN)
 		man_breakscope(man, ROFF_TS);
 	while ((span = tbl_span(tbl)) != NULL) {
 		n = roff_node_alloc(man, line, 0, ROFFT_TBL, TOKEN_NONE);
+		n->tbl_escape = (unsigned char)r->escape;
 		n->span = span;
@@ -1970,7 +1972,7 @@
 	if (r->tbl != NULL && (ctl == 0 || buf->buf[pos] == '\0')) {
 		tbl_read(r->tbl, ln, buf->buf, ppos);
-		roff_addtbl(r->man, ln, r->tbl);
+		roff_addtbl(r, ln, r->tbl);
 		return e;
@@ -2023,7 +2025,7 @@
 	while (buf->buf[pos] == ' ')
 		pos++;
 	tbl_read(r->tbl, ln, buf->buf, pos);
-	roff_addtbl(r->man, ln, r->tbl);
+	roff_addtbl(r, ln, r->tbl);
 	return ROFF_IGN;
 }
--- a/roff.h
+++ b/roff.h
@@ -526,6 +526,7 @@
 	int		  line;    /* Input file line number. */
 	int		  pos;     /* Input file column number. */
 	size_t		  flow_epoch; /* Executed flow boundaries at allocation. */
+	unsigned char	  tbl_escape; /* Active escape when tbl row was read. */
 	int		  flags;
