+static int
+time2tm(time_t t, int utc, struct tm *tm)
+{
+#if defined(_WIN32)
+	return (utc ? gmtime_s(tm, &t) : localtime_s(tm, &t)) == 0;
+#else
+	return (utc ? gmtime_r(&t, tm) : localtime_r(&t, tm)) != NULL;
+#endif
+}
