              "names": ["-x"],
              "forms": ["-x none"],
              "emptyDescription": false,
              "readingContext": null,
              "bodyIncludes": ["NONE_BODY"],
              "bodyExcludes": ["LANGUAGE_BODY", "GLUED_BODY"]
